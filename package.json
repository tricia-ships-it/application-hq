{
  "name": "application-hq",
  "version": "1.0.0",
  "description": "A private, single-file tracker for fellowships, scholarships, fully funded events and grants.",
  "license": "MIT",
  "author": "Patricia Serwaa Kodie Agyekum",
  "repository": {
    "type": "git",
    "url": "https://github.com/tricia-ships-it/application-hq.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "lint": "eslint .",
    "format": "prettier --write src scripts tests",
    "format:check": "prettier --check src scripts tests",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jszip": "3.10.1",
    "playwright": "^1.49.1",
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": ">=20.11"
  }
}
